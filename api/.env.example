# Local development settings for the API. Copy to api/.env (git-ignored):
#   cp api/.env.example api/.env
# `go run ./cmd/server` (and its subcommands) read api/.env when started from api/.
# Variables already set in the shell take precedence. Production does not use this
# file: docker compose passes the root .env instead.

# Embedded dev Postgres started by `go run ./cmd/devdb`.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/assetku?sslmode=disable
# Origin printed in label QR codes.
APP_BASE_URL=http://localhost:3000
# localhost is plain HTTP, so cookies must not be Secure-only here.
COOKIE_SECURE=false
