# Local dev DB: `cd api && go run ./cmd/devdb` (embedded Postgres, port 55432)
# or `docker compose -f docker-compose.dev.yml up -d db` (port 5432, db assetku)
DATABASE_URL=postgres://postgres:postgres@localhost:55432/assetku?sslmode=disable
APP_BASE_URL=http://localhost:3000
ADDR=:8080
COOKIE_SECURE=false
# Tests use an embedded Postgres unless this is set:
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
